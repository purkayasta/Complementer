{
  "name": "complementer",
  "displayName": "Complementer",
  "description": "Context and plan-limit meters, a session manager and usage insights for Claude Code in VS Code. Independent project, not affiliated with Anthropic.",
  "version": "1.2.0",
  "publisher": "pritompurkayasta",
  "author": {
    "name": "purkayasta",
    "url": "https://github.com/purkayasta"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/purkayasta/complementer.git"
  },
  "homepage": "https://github.com/purkayasta/complementer#readme",
  "bugs": {
    "url": "https://github.com/purkayasta/complementer/issues"
  },
  "categories": [
    "AI",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "usage",
    "context window",
    "rate limit",
    "sessions",
    "status bar"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#070c20",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Complementer",
      "properties": {
        "complementer.autoActivateNewChats": {
          "type": "string",
          "enum": ["ask", "off"],
          "default": "ask",
          "description": "When a new chat appears and has no live meters yet: ask before loading them (resumes the chat once in a terminal and sends \"hi\"), or never (the panel then says the context is estimated and the ↻ button loads the exact values)."
        }
      }
    },
    "commands": [
      {
        "command": "complementer.enableLive",
        "title": "Enable live meters",
        "category": "Complementer"
      },
      {
        "command": "complementer.disableLive",
        "title": "Disable live meters",
        "category": "Complementer"
      },
      {
        "command": "complementer.refreshLimits",
        "title": "Refresh limits",
        "category": "Complementer"
      },
      {
        "command": "complementer.dockPanel",
        "title": "Dock panel beside Claude chat",
        "category": "Complementer"
      },
      {
        "command": "complementer.newChat",
        "title": "New Chat",
        "category": "Complementer"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "complementer",
          "title": "Complementer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "complementer": [
        {
          "id": "complementer.panel",
          "type": "webview",
          "name": "Sessions",
          "icon": "resources/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "vscode:uninstall": "node ./out/src/uninstall.js",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p . && tsc -p src/views && node scripts/copy-assets.js",
    "check": "tsc -p . --noEmit && tsc -p src/views --noEmit",
    "test": "npm run build && node --test \"out/test/*.test.js\"",
    "lint": "eslint src test scripts",
    "prepackage": "npm run lint && npm run check && npm test",
    "package": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies --out release/",
    "predeploy": "npm run package",
    "deploy": "npx --yes @vscode/vsce@4.0.0 publish --packagePath release/complementer-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1"
  }
}
